{
  "openapi": "3.0.4",
  "info": {
    "title": "myRecipeBook.API",
    "version": "1.0"
  },
  "paths": {
    "/authentication": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestLoginJson"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestLoginJson"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestLoginJson"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredUserJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredUserJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredUserJson"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              }
            }
          }
        }
      }
    },
    "/recipes": {
      "post": {
        "tags": [
          "Recipes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRecipeJson"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRecipeJson"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRecipeJson"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredRecipeJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredRecipeJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredRecipeJson"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRegisterUserAccountJson"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRegisterUserAccountJson"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRegisterUserAccountJson"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredUserJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredUserJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegistredUserJson"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseUserProfileJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseUserProfileJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseUserProfileJson"
                }
              }
            }
          }
        }
      }
    },
    "/users/profile": {
      "put": {
        "tags": [
          "Users"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUpdateUserJson"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUpdateUserJson"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUpdateUserJson"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              }
            }
          }
        }
      }
    },
    "/users/password": {
      "put": {
        "tags": [
          "Users"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestChangePasswordJson"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestChangePasswordJson"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestChangePasswordJson"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseErrorJson"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CookTime": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "DishType": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "type": "integer",
        "format": "int32"
      },
      "RequestChangePasswordJson": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RequestLoginJson": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RequestRecipeInstructionJson": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RequestRecipeJson": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "cookTime": {
            "$ref": "#/components/schemas/CookTime"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "instructions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestRecipeInstructionJson"
            },
            "nullable": true
          },
          "dishTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DishType"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RequestRegisterUserAccountJson": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RequestUpdateUserJson": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResponseErrorJson": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "readOnly": true
          },
          "accessTokenExpired": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "ResponseRegistredRecipeJson": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResponseRegistredUserJson": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "tokens": {
            "$ref": "#/components/schemas/ResponseTokensJson"
          }
        },
        "additionalProperties": false
      },
      "ResponseTokensJson": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "nullable": true
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResponseUserProfileJson": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter only your access token. Swegger will add 'Bearer' prefix automatically",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Recipes"
    },
    {
      "name": "Users"
    }
  ]
}